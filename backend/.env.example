# ==============================================================================
# MediScan AI - Backend Environment Configuration (Development Defaults)
# ==============================================================================

# Server binding (Render dynamically sets PORT in production)
HOST=0.0.0.0
PORT=8000

# Environment mode: development, staging, production
ENVIRONMENT=development

# Explicit allowed CORS origins (comma-separated list; wildcard '*' is not used by default)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
